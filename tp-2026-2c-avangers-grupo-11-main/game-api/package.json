{
  "name": "game-api",
  "version": "0.1.0",
  "description": "Reusable teaching Game API for the Programacion III final project",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" --max-warnings=0",
    "db:init": "bash scripts/init-database.sh",
    "prestart": "npm run db:init",
    "prestart:dev": "npm run db:init",
    "prestart:debug": "npm run db:init",
    "prestart:prod": "npm run db:init",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "balance:avengers": "npm run build && node scripts/avengers-balance.cjs",
    "prediagnostics:journey": "DB_SEED_THEME=avengers-doomsday npm run db:init",
    "diagnostics:journey": "npm run build && node scripts/avengers-journey-diagnostics.cjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/typeorm": "10.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sqlite3": "5.1.7",
    "swagger-themes": "1.4.3",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@types/node": "20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
